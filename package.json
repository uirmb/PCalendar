{
  "name": "sxwnl-modern",
  "version": "1.4.0",
  "private": true,
  "description": "寿星天文历 V5.09 的 TypeScript 与 HeroUI 风格现代化版本",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node --import tsx scripts/build-standalone.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  },
  "dependencies": {
    "@heroui/styles": "3.2.6"
  }
}
